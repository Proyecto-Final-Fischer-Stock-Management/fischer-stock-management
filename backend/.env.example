# Neon/Vercel database
#
# Use the pooled Neon/Vercel URL for runtime queries.
# In Vercel this is often POSTGRES_PRISMA_URL or POSTGRES_URL.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require"

# Use the non-pooled/direct URL for Prisma Migrate when available.
# In Vercel this is often POSTGRES_URL_NON_POOLING.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB?sslmode=require"

PORT=3000
JWT_SECRET="change-me"
